{
  "appId": "com.iftin.agents",
  "appName": "Iftin Agents",
  "webDir": "dist",
  "android": {
    "captureInput": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable",
      "style": "LIGHT",
      "hidden": false,
      "animation": "NONE"
    },
    "EdgeToEdge": {
      "backgroundColor": "#0F4C81",
      "statusBarColor": "#0F4C81",
      "navigationBarColor": "#0F4C81"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#0F4C81",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false,
      "launchFadeOutDuration": 0
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0F4C81"
    },
    "NavigationBar": {
      "backgroundColor": "#0F4C81",
      "style": "LIGHT"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
