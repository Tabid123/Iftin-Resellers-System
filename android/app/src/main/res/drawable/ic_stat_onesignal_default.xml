<?xml version="1.0" encoding="utf-8"?>
<!--
  OneSignal/Android notification small icon.
  This intentionally reuses the tenant-specific launcher foreground generated by
  the tenant APK build. Android tints notification small icons to a monochrome
  silhouette, so the visual identity comes from the tenant launcher artwork
  while still complying with the platform notification-icon rules.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@mipmap/ic_launcher_foreground"
    android:insetLeft="2dp"
    android:insetTop="2dp"
    android:insetRight="2dp"
    android:insetBottom="2dp" />
